APP_NAME=Arhipelago
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=ro
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# MAIL_SCHEME must agree with MAIL_PORT: 587 is "smtp" (STARTTLS), 465 is
# "smtps" (implicit TLS). Leaving it null lets Laravel infer it from the port.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# The logo in the email header, if it should not be served by this application.
# No mailbox can fetch http://localhost, so on a laptop the header arrives
# broken unless this points somewhere reachable.
MAIL_LOGO_URL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AI (laravel/ai) — Ollama provider. OLLAMA_URL may point at a remote/public Ollama server.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_API_KEY=

# OpenAI: Maya, the travel assistant, answers with it.
OPENAI_API_KEY=
# The model Maya answers with (config/maya.php has her other limits).
MAYA_MODEL=gpt-5.4-mini

# Route measurement: one OSRM server for cars and one for walking.
OSRM_URL_CAR=http://localhost:5001
OSRM_URL_FOOT=http://localhost:5002

# Map tiles the app and the admin draw. OpenStreetMap's own servers are for
# testing only; set a tile provider before launch. The app reads these from
# /api/config, so changing them needs no app update.
MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILES_ATTRIBUTION="© OpenStreetMap contributors"
